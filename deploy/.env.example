# Copy to deploy/.env and adjust. All values have compose defaults, so this file is optional.
# docker compose --env-file .env up -d --build

# ----- PostgreSQL -----
POSTGRES_USER=tenancy
POSTGRES_PASSWORD=tenancy-dev-pass
# mcp-service v5 owns mcp_db; defaults to POSTGRES_PASSWORD in docker-compose.yml.
MCP_DB_PASSWORD=tenancy-dev-pass

# ----- Security (shared by gateway and all services) -----
# Must be at least 16 characters (JwtService validates this).
TENANCY_JWT_SECRET=tenancy-center-dev-secret-change-me-please
TENANCY_INTERNAL_TOKEN=dev-internal-token
# MCP machine-to-machine key (X-API-Key).
TENANCY_MCP_API_KEY=dev-mcp-key

# ----- Agent model (optional; empty => offline scripted model) -----
# TENANCY_AGENT_MODEL_PROVIDER=openai
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=deepseek-chat

# ----- Ports are fixed in docker-compose.yml: gateway 8080, frontend 8088 -----
